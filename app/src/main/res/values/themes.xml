<resources>
    <style name="Theme.PanoramaApp" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="CameraIcon" parent="Widget.Material3.Button.IconButton">
        <item name="android:backgroundTint">#66000000</item>
        <item name="iconTint">@android:color/white</item>
        <item name="android:padding">10dp</item>
    </style>

    <style name="CameraRound" parent="Widget.Material3.Button.IconButton">
        <item name="android:backgroundTint">#8C000000</item>
        <item name="iconTint">@android:color/white</item>
        <item name="iconSize">26dp</item>
        <item name="android:padding">14dp</item>
    </style>

    <style name="CameraChip" parent="Widget.Material3.Button.TonalButton">
        <item name="android:backgroundTint">#66000000</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textSize">12sp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
    </style>
</resources>
